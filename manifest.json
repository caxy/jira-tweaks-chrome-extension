{
  "manifest_version": 3,
  "name": "Jira Tweaks",
  "version": "0.1.0",
  "description": "Makes the read-only Due Date on Jira board issue panels editable, saving through Jira's own REST API with your existing session.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.atlassian.net/*",
        "*://*.jira.com/*"
      ],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
